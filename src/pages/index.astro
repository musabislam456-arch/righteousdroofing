---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ServiceItem from '../components/ServiceItem.astro';
import ReviewQuote from '../components/ReviewQuote.astro';
import { siteConfig } from '../../site.config.mjs';

const reviews = [
  { name: 'Adetsi Sampson', quote: 'You guys did great work for me at Tarkwa. You are fast to, I will refer you to all my friends.', featured: true },
  { name: 'Ayim Daniel', quote: 'They did a neat work for me. I will always recommend them anyday.' },
  { name: 'Michael Asaah', quote: 'I loved the work you did for me at Kintampo I have another at Tarkwa I will call you for that work too.' },
  { name: 'Enoch Frimpong', quote: 'They did a great job' },
  { name: 'Lil King', quote: 'they are the best' },
  { name: 'ADOMGRACE PIXELS (Emeritus Sammy Grace)', quote: 'Excellent roofing service! Professional team, quality workmanship, and great customer service. Highly recommended!' },
  { name: 'Atta', quote: 'You guys did a genuine work' },
  { name: 'Kofi Abekah', quote: 'Wow your hand work are nice I recommend this company to everyone who need best Services' },
  { name: 'Dasty Cartar', quote: 'I’ll always choose RIGHTEOUS-D ROOFING COMPANY because I’m much grateful for choosing them for my roof installation You guys did amazingly good' },
  { name: 'Esther Owusu', quote: 'They are the best' },
  { name: 'George Arthur', quote: 'They the best roofing company' },
];
---
<BaseLayout>
  <Header />
  <main id="home">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero__grid" aria-hidden="true"></div>
      <div class="shell hero__layout">
        <div class="hero__copy reveal">
          <p class="eyebrow"><span class="eyebrow__dash"></span> Roofing · Repairs · Construction</p>
          <h1 id="hero-title">A roof should<br />look right.<br /><em>And do its job.</em></h1>
          <p class="hero__intro">From a new roof installation to a repair that needs attention, talk directly with RIGHTEOUS-D ROOFING COMPANY in Kumasi.</p>
          <div class="hero__actions">
            <a class="button button--accent" href={siteConfig.phoneHref}><span class="button__icon" aria-hidden="true">↗</span> Call {siteConfig.phoneDisplay}</a>
            <a class="text-link text-link--dark" href="#services">Explore our services <span aria-hidden="true">↓</span></a>
          </div>
          <div class="hero__trustline">
            <div class="hero__rating" aria-label="5.0 out of 5, from 14 Google reviews supplied by the owner"><span class="hero__stars" aria-hidden="true">★★★★★</span><strong>{siteConfig.rating}</strong><small>Google listing rating</small></div>
            <span class="hero__trust-divider" aria-hidden="true"></span>
            <div class="hero__location"><span class="mini-pin" aria-hidden="true">⌖</span><span>Plot 4, Block 6<br /><strong>Kumasi, Ghana</strong></span></div>
          </div>
        </div>
        <div class="hero__art-wrap reveal reveal--delay" aria-label="Original architectural illustration of a roofed home; not a photograph of a completed company project" role="img">
          <div class="hero__art-top"><span>BUILT FOR THE EVERYDAY</span><span>GH / KSI</span></div>
          <div class="hero__art-frame">
            <svg class="hero__illustration" viewBox="0 0 700 690" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <pattern id="drawing-grid" width="32" height="32" patternUnits="userSpaceOnUse"><path d="M32 0H0V32" stroke="#77827B" stroke-width=".7" opacity=".36"/></pattern>
                <clipPath id="drawing-clip"><rect width="700" height="690"/></clipPath>
              </defs>
              <g clip-path="url(#drawing-clip)">
                <rect width="700" height="690" fill="#202C28"/>
                <rect width="700" height="690" fill="url(#drawing-grid)"/>
                <path d="M40 579H658" stroke="#8C9A90" stroke-width="1.4" stroke-dasharray="6 8"/>
                <path d="M62 617H638" stroke="#8C9A90" stroke-width=".8" opacity=".55"/>
                <g stroke="#E6E5D8" stroke-width="2.7" stroke-linejoin="round" stroke-linecap="round">
                  <path d="M104 314 347 119 590 314" fill="#E3E0D2"/>
                  <path d="M147 307 347 147 548 307" fill="#273832"/>
                  <path d="M147 307 347 147 548 307" stroke="#F08A43" stroke-width="4"/>
                  <path d="M155 307V530H541V307" fill="#D7D7C9"/>
                  <path d="M155 307 347 383 541 307" fill="#B7BDB2"/>
                  <path d="M155 307 347 383 541 307" stroke="#202C28" stroke-width="2"/>
                  <path d="M347 383V530" stroke="#7D8981" stroke-width="2"/>
                  <path d="M189 351H253V424H189z" fill="#263A34" stroke="#263A34"/>
                  <path d="M207 351V424M235 351V424M189 387H253" stroke="#D7D7C9" stroke-width="2"/>
                  <path d="M438 351H502V424H438z" fill="#263A34" stroke="#263A34"/>
                  <path d="M456 351V424M484 351V424M438 387H502" stroke="#D7D7C9" stroke-width="2"/>
                  <path d="M302 444H392V530H302z" fill="#243A32" stroke="#243A32"/>
                  <path d="M347 444V530" stroke="#E6E5D8" stroke-width="2"/>
                </g>
                <g stroke="#F08A43" stroke-width="2" opacity=".9">
                  <path d="M104 288V258H136"/><path d="M590 288V258H558"/>
                  <path d="M82 314H57V340"/><path d="M612 314H637V340"/>
                  <path d="M347 105V76M333 90H361"/>
                </g>
                <g fill="#E6E5D8" font-family="monospace" font-size="12" letter-spacing="2">
                  <text x="42" y="54">FORM / 01</text><text x="552" y="54">ROOF STUDY</text>
                  <text x="44" y="650">DETAILS MATTER</text><text x="524" y="650">KUMASI, GH</text>
                </g>
                <g stroke="#E6E5D8" stroke-width="1.4" opacity=".65">
                  <path d="M92 119H221M92 119V249"/><path d="M608 119H479M608 119V249"/>
                  <path d="M347 70V100M332 85H362"/>
                </g>
              </g>
            </svg>
            <div class="hero__art-note"><span class="hero__note-mark" aria-hidden="true">↗</span><span>Good work starts<br />with a clear conversation.</span></div>
          </div>
          <div class="hero__art-foot"><span>01 — ROOFING</span><span>02 — REPAIR</span><span>03 — BUILDING</span></div>
        </div>
      </div>
      <div class="hero__bottomline"><span class="shell hero__bottomline-inner"><span>ONE LOCAL TEAM TO TALK TO</span><span class="hero__bottomline-right">Scroll to explore <span aria-hidden="true">↓</span></span></span></div>
    </section>

    <section class="intro-strip" aria-label="Company overview">
      <div class="shell intro-strip__inner">
        <p>When the roof matters, <strong>the details matter.</strong></p>
        <p>Roof installation, roof repair and building construction — as listed in the supplied customer-review information.</p>
      </div>
    </section>

    <section class="services-section section-pad" id="services" aria-labelledby="services-heading">
      <div class="shell">
        <div class="services-section__header">
          <SectionHeading id="services-heading" eyebrow="What we do" title="The work starts here." copy="Tell us what your property needs. We’ll have a conversation about the work you’re planning." number="01 / SERVICES" />
          <a class="text-link services-section__side-link" href={siteConfig.phoneHref}>Discuss a project <span aria-hidden="true">↗</span></a>
        </div>
        <div class="services-list">
          <ServiceItem number="01" title="Roof installation" icon="roof" description="Planning a new roof? Talk through the building, the roof design and the installation work your project calls for." />
          <ServiceItem number="02" title="Roof repair" icon="repair" description="For a roof that needs attention, start with a conversation about the issue and the repair work required." />
          <ServiceItem number="03" title="Building construction" icon="build" description="Discuss your building project, what stage it is at and the construction support you are looking for." />
        </div>
        <div class="services-section__foot"><span class="small-cross" aria-hidden="true">✳</span><p>No made-up price lists or promises. Call to explain your project and discuss next steps.</p></div>
      </div>
    </section>

    <section class="work-section section-pad" id="work" aria-labelledby="work-heading">
      <div class="work-section__texture" aria-hidden="true"></div>
      <div class="shell work-section__inner">
        <SectionHeading id="work-heading" eyebrow="Project showcase" title="Show the real work." copy="The best project gallery is made from the actual site, not someone else’s photos. Authentic RIGHTEOUS-D project images were not discoverable during research, so these frames are clearly marked for replacement." theme="dark" number="02 / FIELD NOTES" />
        <div class="work-comparison">
          <article class="work-frame work-frame--before">
            <div class="work-frame__meta"><span>FIELD NOTE / 01</span><span>PHOTO NEEDED</span></div>
            <div class="work-frame__art work-frame__art--structure" role="img" aria-label="Original vector illustration placeholder showing a roof structure before completion, not a real company project photograph">
              <svg viewBox="0 0 640 420" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="640" height="420" fill="#e3e0d5"/>
                <path d="M0 360 640 360M0 388 640 388" stroke="#a8aea4" stroke-width="1"/>
                <path d="M94 338V198L320 70 546 198V338Z" fill="#c4c5b8" stroke="#485750" stroke-width="3"/>
                <path d="M76 208 320 62 564 208" fill="none" stroke="#485750" stroke-width="8" stroke-linejoin="round"/>
                <path d="M100 196 320 326 540 196M145 169 320 273 495 169M190 142 320 220 450 142" stroke="#7d8b80" stroke-width="7" stroke-linecap="round"/>
                <path d="M125 214V338M190 252V338M255 291V338M385 291V338M450 252V338M515 214V338" stroke="#7d8b80" stroke-width="5"/>
                <path d="M60 338H580" stroke="#ef8743" stroke-width="4"/>
                <g stroke="#65756a" stroke-width="1" opacity=".6"><path d="M32 64H130M32 64V126M608 64H510M608 64V126"/><path d="M320 25V52M306 38H334"/></g>
              </svg>
              <span class="frame-stamp">ILLUSTRATION<br />NOT PHOTOGRAPHY</span>
            </div>
            <div class="work-frame__caption"><div><span class="work-frame__stage">01 / BEFORE</span><h3>On the structure</h3></div><p>Replace with an original site photo.</p></div>
          </article>
          <div class="work-comparison__connector" aria-hidden="true"><span>→</span><small>THE<br />DETAILS</small></div>
          <article class="work-frame work-frame--after">
            <div class="work-frame__meta"><span>FIELD NOTE / 02</span><span>PHOTO NEEDED</span></div>
            <div class="work-frame__art work-frame__art--finished" role="img" aria-label="Original vector illustration placeholder showing a completed metal roof, not a real company project photograph">
              <svg viewBox="0 0 640 420" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <rect width="640" height="420" fill="#d2d7cc"/>
                <path d="M0 360 640 360M0 388 640 388" stroke="#9ba89b" stroke-width="1"/>
                <path d="M94 338V198L320 70 546 198V338Z" fill="#f0eee4" stroke="#263b34" stroke-width="3"/>
                <path d="M76 208 320 62 564 208 320 173Z" fill="#2e5146" stroke="#263b34" stroke-width="4" stroke-linejoin="round"/>
                <path d="M118 194 320 76 522 194M160 198 320 106 480 198M206 202 320 136 434 202M250 207 320 168 390 207" stroke="#6e8a7a" stroke-width="3"/>
                <path d="M118 198 118 338M522 198V338" stroke="#263b34" stroke-width="3"/>
                <path d="M94 338H546" stroke="#ef8743" stroke-width="4"/>
                <path d="M254 338V260H320V338" fill="#2e5146" stroke="#263b34" stroke-width="3"/>
                <path d="M150 238H214V282H150ZM426 238H490V282H426Z" fill="#91a69b" stroke="#263b34" stroke-width="3"/>
                <path d="M182 238V282M150 260H214M458 238V282M426 260H490" stroke="#e7e8df" stroke-width="2"/>
                <g stroke="#65756a" stroke-width="1" opacity=".6"><path d="M32 64H130M32 64V126M608 64H510M608 64V126"/><path d="M320 25V52M306 38H334"/></g>
              </svg>
              <span class="frame-stamp">ILLUSTRATION<br />NOT PHOTOGRAPHY</span>
            </div>
            <div class="work-frame__caption"><div><span class="work-frame__stage">02 / AFTER</span><h3>The finished roof</h3></div><p>Replace with a matching after photo.</p></div>
          </article>
        </div>
        <div class="work-section__disclosure"><span aria-hidden="true">ⓘ</span><p><strong>Photo honesty:</strong> the visuals above are custom illustrations made for this website, not completed RIGHTEOUS-D projects. Customer reviews mention work in Tarkwa and Kintampo; those mentions are not a complete service-area list.</p></div>
        <div class="work-section__bottom"><div><span class="work-section__bottom-number">01—02</span><p>Have project photos ready? They can replace these artwork frames without changing the design.</p></div><a class="button button--outline-light" href={siteConfig.phoneHref}>Discuss your project <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="locations-section section-pad" aria-labelledby="locations-heading">
      <div class="shell locations-section__inner">
        <SectionHeading id="locations-heading" eyebrow="Customer-referenced locations" title="Work that travelled." copy="Customer review excerpts supplied for this website mention Tarkwa and Kintampo. We’re keeping those references grounded in what customers said." number="03 / CUSTOMER NOTES" />
        <div class="location-notes">
          <article class="location-note"><span class="location-note__index">A / REVIEW REFERENCE</span><div class="location-note__place">Tarkwa<span aria-hidden="true">↗</span></div><p>Mentioned in review excerpts from Adetsi Sampson and Michael Asaah.</p></article>
          <article class="location-note"><span class="location-note__index">B / REVIEW REFERENCE</span><div class="location-note__place">Kintampo<span aria-hidden="true">↗</span></div><p>Mentioned in a review excerpt from Michael Asaah.</p></article>
        </div>
        <p class="location-notes__caveat">These are customer references, not a verified list of every area served.</p>
      </div>
    </section>

    <section class="reviews-section section-pad" id="reviews" aria-labelledby="reviews-heading">
      <div class="shell">
        <div class="reviews-section__head">
          <SectionHeading id="reviews-heading" eyebrow="What customers said" title="Good work gets talked about." copy="These excerpts were supplied from the company’s Google listing. They’re shown in the wording provided." number="04 / REVIEWS" />
          <a class="google-summary" href={siteConfig.mapsUrl} target="_blank" rel="noreferrer" aria-label="Open the Google Maps listing to read reviews">
            <span class="google-summary__label">GOOGLE LISTING · SUPPLIED INFO</span>
            <span class="google-summary__score">{siteConfig.rating}<span class="google-summary__stars" aria-hidden="true">★★★★★</span></span>
            <span class="google-summary__count">14 reviews reported</span>
            <span class="google-summary__link">Read on Google <span aria-hidden="true">↗</span></span>
          </a>
        </div>
        <div class="reviews-grid">
          {reviews.map((review, i) => <ReviewQuote {...review} index={String(i + 1).padStart(2, '0')} />)}
        </div>
        <div class="reviews-section__foot"><p><span class="review-stars" aria-hidden="true">★★★★★</span> <strong>11 customer excerpts</strong> are reproduced here; the supplied listing information reports 14 reviews in total. No additional review text has been added.</p><a class="text-link" href={siteConfig.mapsUrl} target="_blank" rel="noreferrer">Read more reviews on Google <span aria-hidden="true">↗</span></a></div>
      </div>
    </section>

    <section class="location-section section-pad" id="location" aria-labelledby="location-heading">
      <div class="shell location-section__heading">
        <SectionHeading id="location-heading" eyebrow="Visit or get directions" title="Find us in Kumasi." copy="Use the map to locate RIGHTEOUS-D ROOFING COMPANY at the supplied Google Maps pin." number="05 / LOCATION" />
        <a class="button button--dark" href={siteConfig.mapsUrl} target="_blank" rel="noreferrer">Get directions <span aria-hidden="true">↗</span></a>
      </div>
      <div class="shell location-section__layout">
        <div class="location-details">
          <div class="location-details__pin" aria-hidden="true"><svg viewBox="0 0 52 64"><path d="M26 3C13.8 3 4 12.8 4 25c0 17 22 36 22 36s22-19 22-36C48 12.8 38.2 3 26 3Z" fill="none" stroke="currentColor" stroke-width="2.5"/><circle cx="26" cy="25" r="7" fill="none" stroke="currentColor" stroke-width="2.5"/></svg></div>
          <span class="location-details__label">ADDRESS</span>
          <h3>RIGHTEOUS-D<br />ROOFING COMPANY</h3>
          <p>{siteConfig.address}</p>
          <div class="location-details__rule"></div>
          <span class="location-details__label">CALL DIRECTLY</span>
          <a class="location-details__phone" href={siteConfig.phoneHref}>{siteConfig.phoneDisplay} <span aria-hidden="true">↗</span></a>
          <p class="location-details__note">Call to talk through roofing installation, repairs or building construction.</p>
          <a class="text-link" href={siteConfig.mapsUrl} target="_blank" rel="noreferrer">Open Google Maps <span aria-hidden="true">↗</span></a>
        </div>
        <div class="map-frame">
          <iframe
            src={siteConfig.mapsEmbed}
            title="Google Maps location for RIGHTEOUS-D ROOFING COMPANY, Plot 4 Block 6, Kumasi, Ghana"
            width="600"
            height="450"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"></iframe>
          <div class="map-frame__caption"><span><span class="map-frame__dot"></span> Google Maps location</span><a href={siteConfig.mapsUrl} target="_blank" rel="noreferrer">Get directions ↗</a></div>
        </div>
      </div>
    </section>

    <section class="contact-section" id="contact" aria-labelledby="contact-heading">
      <div class="contact-section__line" aria-hidden="true"></div>
      <div class="shell contact-section__inner">
        <div class="contact-section__tag"><span class="status-dot" aria-hidden="true"></span> HAVE A PROJECT IN MIND?</div>
        <h2 id="contact-heading">Let’s talk about<br /><em>what goes overhead.</em></h2>
        <div class="contact-section__bottom"><p>Roof installation, repair or building construction. Start with a direct call to RIGHTEOUS-D ROOFING COMPANY.</p><a class="button button--light" href={siteConfig.phoneHref}>Call {siteConfig.phoneDisplay} <span aria-hidden="true">↗</span></a></div>
        <svg class="contact-section__roofline" viewBox="0 0 380 140" fill="none" aria-hidden="true"><path d="M6 134 190 7l184 127" stroke="currentColor" stroke-width="1.4"/><path d="M47 134 190 35l143 99" stroke="currentColor" stroke-width="1.2"/><path d="M74 134V84l116 80 116-80v50" stroke="currentColor" stroke-width="1.2"/></svg>
      </div>
    </section>
  </main>
  <Footer />
  <a class="mobile-call" href={siteConfig.phoneHref} aria-label={`Call RIGHTEOUS-D ROOFING COMPANY at ${siteConfig.phoneDisplay}`}><span aria-hidden="true">☎</span> Call the team</a>
  <script>
    const toggle = document.querySelector('.menu-toggle');
    const nav = document.querySelector('#primary-navigation');
    if (toggle && nav) {
      const closeMenu = () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Open navigation menu');
        nav.classList.remove('is-open');
        document.body.classList.remove('menu-open');
      };
      toggle.addEventListener('click', () => {
        const expanded = toggle.getAttribute('aria-expanded') === 'true';
        toggle.setAttribute('aria-expanded', String(!expanded));
        toggle.setAttribute('aria-label', expanded ? 'Open navigation menu' : 'Close navigation menu');
        nav.classList.toggle('is-open', !expanded);
        document.body.classList.toggle('menu-open', !expanded);
      });
      nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      window.addEventListener('resize', () => { if (window.innerWidth > 860) closeMenu(); });
    }

    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const revealItems = document.querySelectorAll('.reveal');
    if (reducedMotion || !('IntersectionObserver' in window)) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries, obs) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            obs.unobserve(entry.target);
          }
        });
      }, { rootMargin: '0px 0px -48px 0px', threshold: 0.08 });
      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</BaseLayout>
